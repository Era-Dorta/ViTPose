    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "train",
            "type": "debugpy",
            "module": "torch.distributed.launch",
            "request": "launch",
            "console": "integratedTerminal",
            "args": [
                "--nproc_per_node", "1",  // number of GPUs
                "--master_port", "29500",
                "/workspace/tools/train.py",
                "configs/body/2d_kpt_sview_rgb_img/topdown_heatmap/coco/ViTPose_small_coco_256x192.py",
                "--launcher", "pytorch",
                "--cfg-options", "model.pretrained=data/coco/vitpose-b-multi-coco.pth",
                "--seed", "0",               
            ]
        },
        {
            "name": "train-conflab",
            "type": "debugpy",
            "module": "torch.distributed.launch",
            "request": "launch",
            "console": "integratedTerminal",
            "args": [
                "--nproc_per_node", "2", // number of GPUs
                "--master_port", "29500",
                "/workspace/tools/train.py",
                "configs/body/2d_kpt_sview_rgb_img/topdown_heatmap/coco/ViTPose_small_coco_256x192.py",
                // "ViTPose/configs/ViTPose_coco_plus_conflab_w_bg_256x192.py",
                "--launcher", "pytorch",
                "--cfg-options", "model.pretrained=data/coco/vitpose-b-multi-coco.pth",
                "--seed", "0",
            ],
            "justMyCode": false
        },
        {
            "name": "train-conflab-no-dist",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/tools/train.py",
            "args": [
                // "configs/body/2d_kpt_sview_rgb_img/topdown_heatmap/coco/ViTPose_small_coco_256x192.py",
                "configs/ViTPose_coco_plus_conflab_w_bg_256x192.py",
                "--cfg-options", "model.pretrained=data/coco/vitpose-b-multi-coco.pth",
                "--seed", "0",
            ],
            "justMyCode": true
        },
        {
            "name": "preprocess-conflab",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "program": "${workspaceFolder}/tools/dataset/preprocess_conflab.py",
            "args": [                
                "--netid", "edortaperez",
